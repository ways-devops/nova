# База данных (совпадает с docker-compose.yml)
DATABASE_URL="postgresql://nova:nova_password@localhost:5432/nova_crm?schema=public"

# Секрет для подписи сессий (минимум 32 символа).
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Единственный пользователь — создаётся командой `npm run db:seed`
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="Администратор"

# Публичный адрес CRM с HTTPS (после развёртывания, этап 5).
# Нужен для ссылок в Telegram и для webhook Авито. Локально оставьте пустым.
APP_URL=""

# Telegram: токен от @BotFather. chat id найдите кнопкой в Настройках
# (сначала напишите боту любое сообщение).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Авито: ключи приложения из личного кабинета разработчика (developers.avito.ru)
AVITO_CLIENT_ID=""
AVITO_CLIENT_SECRET=""
# Секрет в адресе webhook, от 16 символов. Сгенерировать: openssl rand -hex 24
AVITO_WEBHOOK_SECRET=""

# Секрет для запуска напоминаний внешним cron (необязательно).
# Сгенерировать: openssl rand -hex 24
CRON_SECRET=""
